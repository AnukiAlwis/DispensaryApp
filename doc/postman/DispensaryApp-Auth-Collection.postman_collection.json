{
  "info": {
    "name": "DispensaryApp - Authentication",
    "description": "Collection for testing authentication endpoints with automatic token management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"tenantCode\": \"{{tenantCode}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login endpoint - stores accessToken and refreshToken in environment variables automatically"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse response JSON",
              "var jsonData = pm.response.json();",
              "",
              "// Check if login was successful",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has accessToken\", function () {",
              "    pm.expect(jsonData).to.have.property('accessToken');",
              "});",
              "",
              "pm.test(\"Response has refreshToken\", function () {",
              "    pm.expect(jsonData).to.have.property('refreshToken');",
              "});",
              "",
              "pm.test(\"Response has user\", function () {",
              "    pm.expect(jsonData).to.have.property('user');",
              "});",
              "",
              "// Store tokens in environment variables",
              "if (jsonData.accessToken) {",
              "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
              "}",
              "",
              "if (jsonData.refreshToken) {",
              "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
              "}",
              "",
              "// Store user info",
              "if (jsonData.user) {",
              "    pm.environment.set(\"userId\", jsonData.user.id);",
              "    pm.environment.set(\"userRole\", jsonData.user.role);",
              "}",
              "",
              "console.log('Tokens stored successfully');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "refresh"]
        },
        "description": "Refresh endpoint - updates accessToken and refreshToken in environment variables automatically"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse response JSON",
              "var jsonData = pm.response.json();",
              "",
              "// Check if refresh was successful",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has new accessToken\", function () {",
              "    pm.expect(jsonData).to.have.property('accessToken');",
              "});",
              "",
              "pm.test(\"Response has new refreshToken\", function () {",
              "    pm.expect(jsonData).to.have.property('refreshToken');",
              "});",
              "",
              "// Update tokens in environment variables",
              "if (jsonData.accessToken) {",
              "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
              "}",
              "",
              "if (jsonData.refreshToken) {",
              "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
              "}",
              "",
              "console.log('Tokens refreshed successfully');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "logout"]
        },
        "description": "Logout endpoint - clears tokens from environment variables"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Check if logout was successful",
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "// Clear tokens from environment variables",
              "pm.environment.set(\"accessToken\", \"\");",
              "pm.environment.set(\"refreshToken\", \"\");",
              "pm.environment.set(\"userId\", \"\");",
              "pm.environment.set(\"userRole\", \"\");",
              "",
              "console.log('Tokens cleared successfully');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Get Patients (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}",
            "description": "Informational only - not used for auth"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": ["{{baseUrl}}"],
          "path": ["patients"]
        },
        "description": "Protected endpoint - requires valid accessToken. Uses {{accessToken}} environment variable automatically."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Get Patients (No Auth - Should Fail)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": ["{{baseUrl}}"],
          "path": ["patients"]
        },
        "description": "Protected endpoint without auth - should return 401"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Get Users (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "Protected endpoint - requires valid accessToken"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Get Medicines (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Tenant-ID",
            "value": "{{tenantId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/medicines",
          "host": ["{{baseUrl}}"],
          "path": ["medicines"]
        },
        "description": "Protected endpoint - requires valid accessToken"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
